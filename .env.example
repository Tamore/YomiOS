# Yomi Configuration Template

# Server Bindings
YOMI_HOST=127.0.0.1
YOMI_PORT=8765
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8765,http://localhost:8765

# Security Controls
# Set to 'true' only if you explicitly want to allow unauthenticated arbitrary local Python script execution via /api/sandbox/execute
YOMI_ENABLE_DEV_RUNNER=false

# LLM Providers (Optional - Local Ollama is used by default)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
GROQ_API_KEY=


# Optional absolute path outside the repository (default: ~/.yomi)
# YOMI_WORKSPACE_ROOT=
